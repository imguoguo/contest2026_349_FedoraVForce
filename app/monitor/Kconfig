#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LVX_USE_DEMO_MONITOR
	bool "LVGL system monitor"
	default n
	depends on GRAPHICS_LVGL && FS_PROCFS
	select LV_USE_NUTTX
	select LV_USE_NUTTX_TOUCHSCREEN
	select LVX_UI
	---help---
		Per CPU load, memory and task list.  The per CPU load needs CPU
		load measurement, e.g. SCHED_CPULOAD_SYSCLK.
