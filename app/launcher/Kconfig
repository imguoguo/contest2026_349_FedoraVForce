#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LVX_USE_DEMO_LAUNCHER
	bool "LVGL launcher"
	default n
	depends on GRAPHICS_LVGL && BUILTIN
	select LV_USE_NUTTX
	select LV_USE_NUTTX_TOUCHSCREEN
	select LVX_UI
	select SCHED_WAITPID
	---help---
		Lock screen and dashboard home that lists and starts LVGL
		builtin apps.

if LVX_USE_DEMO_LAUNCHER

config LVX_LAUNCHER_APPS
	string "Apps shown in the launcher"
	default ""
	---help---
		Space separated list of LVGL builtin apps, e.g. "paint bench".
		Apps that are not built into the image are skipped.

endif
