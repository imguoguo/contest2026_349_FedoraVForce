# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LVX_USE_DEMO_BENCH
	bool "LVGL benchmark"
	default n
	depends on GRAPHICS_LVGL
	select LV_USE_NUTTX
	select LV_USE_NUTTX_TOUCHSCREEN
	select LVX_UI
	select LVX_DIGIT
	---help---
		LVGL render scenes with real frame rate and frame time, CoreMark
		on one core, CPU / memory throughput, paint's digit recognition
		on TFLite Micro against the plain C inference, and screen test
		patterns.
		CoreMark needs BENCHMARK_COREMARK and PIPES, without them it
		shows N/A.
