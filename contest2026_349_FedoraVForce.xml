<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_349_FedoraVForce" name="contest2026_349_FedoraVForce">
    <linkfile src="app/launcher" dest="packages/demos/contest2026_349_launcher"/>
    <linkfile src="app/paint" dest="packages/demos/contest2026_349_paint"/>
    <linkfile src="app/bench" dest="packages/demos/contest2026_349_bench"/>
    <linkfile src="app/monitor" dest="packages/demos/contest2026_349_monitor"/>
    <linkfile src="app/ui" dest="packages/demos/contest2026_349_ui"/>
    <linkfile src="app/digit" dest="packages/demos/contest2026_349_digit"/>
    <linkfile src="app/touch" dest="packages/demos/contest2026_349_touch"/>
    <linkfile src="app/lvdemo" dest="packages/demos/contest2026_349_lvdemo"/>
    <linkfile src="board/contest_board" dest="vendor/openvela/boards/contest2026_349_board"/>
  </project>
</manifest>
